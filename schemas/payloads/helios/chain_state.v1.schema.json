{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falcon.thegoal.internal/schemas/payloads/helios/chain_state.v1.schema.json",
  "title": "FalconEvent payload: helios.chain_state (v1)",
  "description": "Typed payload schema for registered FALCON event family 'helios.chain_state'.",
  "type": "object",
  "properties": {
    "chain_id": {
      "type": "string",
      "minLength": 1
    },
    "chain_state": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACTIVE",
        "COMPLETED",
        "ABORTED"
      ]
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "chain_id",
    "chain_state"
  ],
  "additionalProperties": false
}
