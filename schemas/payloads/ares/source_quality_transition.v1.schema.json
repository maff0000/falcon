{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falcon.thegoal.internal/schemas/payloads/ares/source_quality_transition.v1.schema.json",
  "title": "FalconEvent payload: ares.source_quality.transition (v1)",
  "description": "Typed payload schema for registered FALCON event family 'ares.source_quality.transition'.",
  "type": "object",
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "ares_previous_quality_state": {
      "type": "string",
      "enum": [
        "RELIABLE",
        "DEGRADED",
        "UNAVAILABLE",
        "UNKNOWN"
      ]
    },
    "ares_new_quality_state": {
      "type": "string",
      "enum": [
        "RELIABLE",
        "DEGRADED",
        "UNAVAILABLE",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "source_id",
    "ares_previous_quality_state",
    "ares_new_quality_state"
  ],
  "additionalProperties": false
}
