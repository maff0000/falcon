# =============================================================================
# FALCON PID-02 — Graylog DEV stack environment template
#
# This file is Git-tracked and carries NO real secrets — every value below
# is a placeholder or a documented non-secret default. Copy it to a real
# `.env` (gitignored) and fill in real values, or run `./bootstrap.sh`
# which does this for you with freshly generated random secrets.
#
# Doctrine (docs/operations/FALCON-CONFIGURATION-AND-SECRETS.md):
#   container image      = software
#   this file            = non-secret behavioural template (Git-tracked)
#   real ./.env           = installation-specific values + secrets (NOT Git-tracked)
#   named Docker volumes  = persistent state
#
# Missing required values fail loudly: docker-compose.yml uses the
# ${VAR:?message} form for every one of these, so `docker compose up`
# refuses to start any container with an unset/empty required variable.
# =============================================================================

# --- MongoDB (shared by graylog-falcon + datanode-falcon) -------------------
# Root credentials for FALCON's own mongodb-falcon container. Used to build
# the mongodb_uri for both Graylog and Data Node. Not FALCON's canonical
# evidence store — MongoDB here only holds Graylog/Data Node metadata
# (users, index-set definitions, node state); evidence itself lives in
# the Data Node's OpenSearch indices.
FALCON_MONGO_ROOT_USERNAME=falcon_mongo_root
FALCON_MONGO_ROOT_PASSWORD=CHANGE_ME_REPLACE_WITH_LONG_RANDOM_VALUE

# --- Graylog / Data Node shared cluster secret -------------------------------
# MUST be identical on graylog-falcon and datanode-falcon (it peppers stored
# credentials and secures inter-node communication). Graylog's own
# documentation requires at least 64 characters. Generate with, e.g.:
#   openssl rand -hex 48
FALCON_GRAYLOG_PASSWORD_SECRET=CHANGE_ME_REPLACE_WITH_64_PLUS_CHAR_RANDOM_SECRET

# --- Graylog root (admin) user ------------------------------------------------
# SHA-256 hex digest of the root user's plaintext password (root username is
# fixed to Graylog's built-in default, "admin"; this cannot be changed via
# the API/GUI — only by changing this hash and restarting). Generate with:
#   echo -n 'your-password-here' | sha256sum
# bootstrap.sh generates a random password, hashes it here, and prints the
# plaintext exactly once so it can be captured — it is never stored in
# plaintext in this repo or in the generated .env.
FALCON_GRAYLOG_ROOT_PASSWORD_SHA2=CHANGE_ME_REPLACE_WITH_SHA256_HEX_OF_A_PASSWORD

# --- Timezone doctrine (FF-GUI-TIME-01) --------------------------------------
# Canonical storage/API/correlation timestamps remain UTC always, everywhere.
# This setting affects ONLY how the Graylog root/admin user's GUI renders
# timestamps (Europe/London -> GMT in winter, BST in summer automatically).
# Do NOT set this to UTC and do NOT use a fixed numeric offset.
# Every future FALCON operator account's per-profile timezone should also be
# set to Europe/London (System > Users > <user> > timezone) for the same
# reason — see deploy/README.md for the empirically-verified admin-vs-user
# behaviour.
FALCON_GRAYLOG_ROOT_TIMEZONE=Europe/London

# --- HTTP exposure ------------------------------------------------------------
# LAN IP + port the Graylog GUI/REST API is published on. Bound explicitly to
# this single host IP (never 0.0.0.0) so the service is reachable on the
# dell-debian LAN but not wide-open on every interface/container network.
FALCON_GRAYLOG_HOST_BIND_IP=192.168.11.10
FALCON_GRAYLOG_HOST_PORT=9010
# Host port the dedicated HERMES GELF TCP mTLS input (container port 12411) is
# published on, on the same bind IP above (PID-05 Stage 2). Non-secret. Ports
# 12412-12415 (ARES/HELIOS/TRON) remain unpublished.
FALCON_HERMES_INPUT_HOST_PORT=12411
# External URI Graylog reports to clients/itself; must match the published
# host/port above (trailing slash required by Graylog).
FALCON_GRAYLOG_HTTP_EXTERNAL_URI=http://192.168.11.10:9010/
